# =============================================================================
# BioLink Platform — Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env files to version control.
# Generate secrets with: openssl rand -hex 32
# =============================================================================

# ============================================
# Core Application
# ============================================
ENVIRONMENT=development
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_OPENSSL_RAND_HEX_32

# ============================================
# PostgreSQL (Main Database)
# ============================================
POSTGRES_USER=biolink
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_DEV_PASSWORD
POSTGRES_DB=biolink
DATABASE_URL=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# ============================================
# pgvector (RAG / Vector Store)
# ============================================
PGVECTOR_USER=biolink
PGVECTOR_PASSWORD=CHANGE_ME_LOCAL_DEV_PASSWORD
PGVECTOR_DB=biolink_vector
RAG_PG_URL=postgresql://${PGVECTOR_USER}:${PGVECTOR_PASSWORD}@pgvector:5432/${PGVECTOR_DB}

# ============================================
# Redis (Caching & Rate Limiting)
# ============================================
REDIS_URL=redis://redis:6379/0
RATE_LIMIT_STORAGE_URL=memory://

# ============================================
# AI / LLM (Ollama)
# ============================================
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=Qwen2.5:7B-Instruct
OLLAMA_ORCHESTRATOR_MODEL=Qwen2.5:7B
OLLAMA_DATA_MODEL=Qwen2.5:7B-Instruct
OLLAMA_MEDICAL_MODEL=alibayram/medgemma:4b
OLLAMA_CODING_MODEL=Qwen2.5:7B-Instruct

# Agent Configuration
SQL_AGENT_DEFAULT_LIMIT=200
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_S=0.4
LLM_RETRY_JITTER_S=0.2
ORCHESTRATOR_LLM_TIMEOUT_S=8.0
DATA_LLM_TIMEOUT_S=20.0
MEDICAL_LLM_TIMEOUT_S=20.0

# RAG Configuration
RAG_EMBEDDING_MODEL=nomic-embed-text
RAG_EMBEDDING_DIM=768
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=5

# ============================================
# Superset (Embedded Analytics)
# ============================================
SUPERSET_URL=http://superset:8088
SUPERSET_PUBLIC_URL=http://localhost:8088
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=CHANGE_ME_SUPerset_PASSWORD
SUPERSET_ADMIN_EMAIL=admin@biolink.local
SUPERSET_ADMIN_FIRSTNAME=Bio
SUPERSET_ADMIN_LASTNAME=Link
SUPERSET_DATABASE_NAME=BioLink PostgreSQL
SUPERSET_DATABASE_URI=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
SUPERSET_DEFAULT_SCHEMA=public
SUPERSET_DEFAULT_TABLE=unified_registry
SUPERSET_SECRET_KEY=CHANGE_ME_SUPERSET_SECRET_KEY

# ============================================
# NiFi (ETL Pipeline)
# ============================================
NIFI_USERNAME=admin
NIFI_PASSWORD=CHANGE_ME_NIFI_PASSWORD
NIFI_SENSITIVE_PROPS_KEY=CHANGE_ME_NIFI_SENSITIVE_KEY

# ============================================
# Azure Entra ID (Optional — Production SSO)
# ============================================
AZURE_ENTRA_ENABLED=false
AZURE_ENTRA_TENANT_ID=
AZURE_ENTRA_CLIENT_ID=
AZURE_ENTRA_AUDIENCE=
AZURE_ENTRA_ALLOWED_EMAILS=
AZURE_ENTRA_ADMIN_EMAILS=

# ============================================
# Frontend Build Args
# ============================================
VITE_BACKEND_URL=http://localhost:3001
VITE_OLLAMA_BASE_URL=http://localhost:11434
VITE_OLLAMA_MODEL=Qwen2.5:7B-Instruct
VITE_OLLAMA_TOOL_MODEL=Qwen2.5:7B-Instruct
VITE_OLLAMA_TOOL_MODEL_FALLBACK=qwen2.5:0.5b
VITE_SUPERSET_URL=http://localhost:8088
VITE_NIFI_URL=

# ============================================
# Monitoring & Observability
# ============================================
ENABLE_METRICS=true
METRICS_PORT=9090
SENTRY_DSN=
LOG_LEVEL=INFO

# ============================================
# Feature Flags
# ============================================
ALLOW_SELF_REGISTRATION=false
BOOTSTRAP_DEMO_USERS=false
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@biolink.local
BOOTSTRAP_ADMIN_FULL_NAME=Administrator
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_BOOTSTRAP_ADMIN_PASSWORD_MIN_12_CHARS
