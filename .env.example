# BioLink Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# Database Configuration
# ============================================
POSTGRES_USER=biolink
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=biolink
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}

# pgvector (for RAG)
PGVECTOR_USER=biolink
PGVECTOR_PASSWORD=your_secure_password_here
PGVECTOR_DB=biolink_vector
RAG_PG_URL=postgresql://${PGVECTOR_USER}:${PGVECTOR_PASSWORD}@localhost:5433/${PGVECTOR_DB}

# SQL Server (EHVol Registry)
SQLSERVER_HOST=localhost
SQLSERVER_PORT=1433
SQLSERVER_DB=EHVol
SQLSERVER_USER=readonly_user
SQLSERVER_PASSWORD=your_sqlserver_password_here
SQLSERVER_DRIVER="ODBC Driver 18 for SQL Server"
SQLSERVER_TRUST_CERT=yes
MSSQL_SA_PASSWORD=your_strong_sa_password_here

# ============================================
# AI/LLM Configuration
# ============================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=Qwen2.5:7B-Instruct
OLLAMA_ORCHESTRATOR_MODEL=Qwen2.5:7B
OLLAMA_DATA_MODEL=Qwen2.5:7B-Instruct
OLLAMA_MEDICAL_MODEL=alibayram/medgemma:4b
OLLAMA_CODING_MODEL=Qwen2.5:7B-Instruct

# ============================================
# Security
# ============================================
# Generate with: openssl rand -hex 32
SECRET_KEY=your_secret_key_here_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10

# ============================================
# Superset Configuration
# ============================================
SUPERSET_URL=http://localhost:8088
SUPERSET_PUBLIC_URL=http://localhost:8088
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=your_superset_password_here

# ============================================
# Redis (Caching)
# ============================================
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=300

# ============================================
# Application Settings
# ============================================
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=3001

# Frontend
FRONTEND_URL=http://localhost:5173

# ============================================
# Monitoring & Observability
# ============================================
ENABLE_METRICS=true
METRICS_PORT=9090
SENTRY_DSN=

# ============================================
# Feature Flags
# ============================================
ENABLE_AUTH=false
ENABLE_RATE_LIMITING=true
ENABLE_CACHE=true
ENABLE_AUDIT_LOG=true
