# Azure scope
AZURE_SUBSCRIPTION_ID=
AZURE_LOCATION=eastus
AZURE_POSTGRES_LOCATION=
AZURE_RESOURCE_GROUP=biolink-preview-rg
AZURE_CONTAINERAPPS_ENV=biolink-preview-env

# Registry and image tagging
# ACR names must be globally unique and use only lowercase letters and numbers.
AZURE_ACR_NAME=biolinkpreviewacr
IMAGE_TAG=preview

# Preview app names
BACKEND_APP_NAME=biolink-preview-api
FRONTEND_APP_NAME=biolink-preview-web
SUPERSET_APP_NAME=biolink-preview-superset
PREVIEW_ALLOWED_CIDR=

# PostgreSQL
AZURE_POSTGRES_SERVER=biolink-preview-pg
AZURE_POSTGRES_ADMIN=biolinkadmin
AZURE_POSTGRES_ADMIN_PASSWORD=
AZURE_POSTGRES_DATABASE=biolink
AZURE_POSTGRES_VECTOR_DATABASE=biolink_vector

# App bootstrap and preview access
APP_SECRET_KEY=
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_FULL_NAME=

# Azure Entra configuration
AZURE_ENTRA_TENANT_ID=
AZURE_ENTRA_BACKEND_CLIENT_ID=
AZURE_ENTRA_FRONTEND_CLIENT_ID=
AZURE_ENTRA_API_SCOPE=
AZURE_ENTRA_AUTHORITY=
AZURE_ENTRA_AUDIENCE=
AZURE_ENTRA_ALLOWED_EMAILS=
AZURE_ENTRA_ADMIN_EMAILS=

# Production-safe defaults for the preview
ALLOW_SELF_REGISTRATION=false
BOOTSTRAP_DEMO_USERS=false
RATE_LIMIT_STORAGE_URL=memory://

# Optional Superset overrides.
# Leave these blank to default to the bootstrap admin identity, APP_SECRET_KEY, and
# the built-in verification dashboard slug.
SUPERSET_ADMIN_USER=
SUPERSET_ADMIN_PASSWORD=
SUPERSET_ADMIN_EMAIL=
SUPERSET_SECRET_KEY=
SUPERSET_VERIFICATION_DASHBOARD_SLUG=biolink-verification-dashboard

# Optional feature overrides
VITE_NIFI_URL=
VITE_SUPERSET_URL=
VITE_SUPERSET_DASHBOARD_ID=
VITE_OLLAMA_BASE_URL=