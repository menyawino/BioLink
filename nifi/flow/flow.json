{
  "encodingVersion": {
    "majorVersion": 2,
    "minorVersion": 0
  },
  "maxTimerDrivenThreadCount": 10,
  "maxEventDrivenThreadCount": 1,
  "flowRegistryClients": [],
  "parameterContexts": [
    {
      "identifier": "biolink-params",
      "name": "BioLink Parameters",
      "parameters": [
        {
          "name": "db.host",
          "description": "PostgreSQL host",
          "sensitive": false,
          "value": "postgres"
        },
        {
          "name": "db.port",
          "description": "PostgreSQL port",
          "sensitive": false,
          "value": "5432"
        },
        {
          "name": "db.name",
          "description": "Database name",
          "sensitive": false,
          "value": "biolink"
        },
        {
          "name": "db.user",
          "description": "Database user",
          "sensitive": false,
          "value": "biolink"
        },
        {
          "name": "db.password",
          "description": "Database password",
          "sensitive": true,
          "value": "biolink_secret"
        },
        {
          "name": "db.url",
          "description": "JDBC URL",
          "sensitive": false,
          "value": "jdbc:postgresql://postgres:5432/biolink"
        },
        {
          "name": "jdbc.driver.path",
          "description": "JDBC driver path",
          "sensitive": false,
          "value": "/opt/nifi/jdbc/postgresql-42.7.3.jar"
        },
        {
          "name": "data.directory",
          "description": "CSV data directory",
          "sensitive": false,
          "value": "/opt/nifi/db"
        }
      ],
      "inheritedParameterContexts": []
    }
  ],
  "controllerServices": [],
  "rootGroup": {
    "identifier": "biolink-root",
    "instanceIdentifier": "biolink-root-instance",
    "name": "BioLink ETL Pipeline",
    "comments": "NiFi execution of the active db/test BioLink registry pipeline.",
    "position": { "x": 0, "y": 0 },
    "parameterContextName": "BioLink Parameters",
    "processGroups": [
      {
        "identifier": "pg-registry-pipeline",
        "instanceIdentifier": "pg-registry-pipeline-instance",
        "name": "Registry Pipeline (db/test)",
        "comments": "Runs the replacement db/test pipeline, publishes compatibility outputs, and loads PostgreSQL tables.",
        "position": { "x": 100, "y": 1800 },
        "parameterContextName": "BioLink Parameters",
        "processGroups": [],
        "remoteProcessGroups": [],
        "processors": [
          {
            "identifier": "registry-pipeline-trigger",
            "name": "GenerateFlowFile - Trigger Registry Pipeline",
            "type": "org.apache.nifi.processors.standard.GenerateFlowFile",
            "position": { "x": 0, "y": 0 },
            "config": {
              "properties": {
                "File Size": "0B",
                "Batch Size": "1",
                "Data Format": "Text",
                "Unique FlowFiles": "false"
              },
              "schedulingPeriod": "24 hours",
              "schedulingStrategy": "TIMER_DRIVEN"
            }
          },
          {
            "identifier": "registry-scripted-pipeline",
            "name": "Run Scripted Registry Pipeline",
            "type": "org.apache.nifi.processors.python.BiolinkRegistryPipelineProcessor",
            "position": { "x": 340, "y": 0 },
            "config": {
              "properties": {
                "Repository Root": "/opt/nifi/biolink_repo",
                "Unified Output Relative Path": "outputs/unified_registry.csv",
                "Quality Report Relative Path": "outputs/data_quality_report.html",
                "Characterization Relative Path": "outputs/cohort_characterization.csv",
                "Comparability Report Relative Path": "outputs/comparability_report.json",
                "Load To PostgreSQL": "true",
                "Database Host": "postgres",
                "Database Port": "5432",
                "Database Name": "biolink",
                "Database User": "biolink",
                "Database Password": "biolink_secret",
                "Unified Registry Table": "unified_registry"
              }
            }
          },
          {
            "identifier": "registry-pipeline-log",
            "name": "LogMessage - Registry Pipeline Complete",
            "type": "org.apache.nifi.processors.standard.LogMessage",
            "position": { "x": 700, "y": 0 },
            "config": {
              "properties": {
                "Log Level": "info",
                "Log Message": "Registry pipeline complete: ${biolink.registry.rows} rows, ${biolink.registry.columns} columns"
              }
            }
          }
        ],
        "connections": [
          {
            "identifier": "c-rp-1",
            "source": { "id": "registry-pipeline-trigger", "type": "PROCESSOR" },
            "destination": { "id": "registry-scripted-pipeline", "type": "PROCESSOR" },
            "selectedRelationships": ["success"]
          },
          {
            "identifier": "c-rp-2",
            "source": { "id": "registry-scripted-pipeline", "type": "PROCESSOR" },
            "destination": { "id": "registry-pipeline-log", "type": "PROCESSOR" },
            "selectedRelationships": ["success"]
          },
          {
            "identifier": "c-rp-f",
            "source": { "id": "registry-scripted-pipeline", "type": "PROCESSOR" },
            "destination": { "id": "registry-scripted-pipeline", "type": "PROCESSOR" },
            "selectedRelationships": ["failure"]
          }
        ],
        "controllerServices": [],
        "inputPorts": [],
        "outputPorts": [],
        "funnels": [],
        "labels": []
      }
    ],
    "remoteProcessGroups": [],
    "processors": [],
    "connections": [],
    "inputPorts": [],
    "outputPorts": [],
    "funnels": [],
    "labels": [],
    "controllerServices": [],
    "defaultFlowFileExpiration": "0 sec",
    "defaultBackPressureObjectThreshold": 10000,
    "defaultBackPressureDataSizeThreshold": "1 GB"
  }
}