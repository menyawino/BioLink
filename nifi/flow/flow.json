      {
        "identifier": "pg-schema-gen",
        "instanceIdentifier": "pg-schema-gen-instance",
        "name": "Schema Generation Pipeline (Step 1)",
        "comments": "Runs BiolinkMasterSchemaProcessor once to produce master_schema.csv",
        "position": { "x": 100, "y": 1200 },
        "parameterContextName": "BioLink Parameters",
        "processGroups": [],
        "remoteProcessGroups": [],
        "processors": [
          {
            "identifier": "schema-gen-trigger",
            "name": "GenerateFlowFile - Trigger Schema Gen",
            "type": "org.apache.nifi.processors.standard.GenerateFlowFile",
            "position": { "x": 0, "y": 0 },
            "config": {
              "properties": {
                "File Size": "0B",
                "Batch Size": "1",
                "Data Format": "Text",
                "Unique FlowFiles": "false"
              },
              "schedulingPeriod": "24 hours",
              "schedulingStrategy": "TIMER_DRIVEN"
            }
          },
          {
            "identifier": "schema-gen-processor",
            "name": "MasterSchema - Generate Schema",
            "type": "org.apache.nifi.processors.python.BiolinkMasterSchemaProcessor",
            "position": { "x": 300, "y": 0 },
            "config": {
              "properties": {
                "BHS CSV Path":       "/opt/nifi/db/BHS_Full.csv",
                "EHVol CSV Path":     "/opt/nifi/db/EHVol_Full.csv",
                "Schema Output Path": "/opt/nifi/outputs/master_schema.csv",
                "Match Threshold":    "0.35",
                "Top K":              "5",
                "Lexicon Path":       "/opt/nifi/biolink_scripts/clinical_lexicon.csv"
              }
            }
          },
          {
            "identifier": "schema-gen-log",
            "name": "LogMessage - Schema Generated",
            "type": "org.apache.nifi.processors.standard.LogMessage",
            "position": { "x": 600, "y": 0 },
            "config": {
              "properties": {
                "Log Level": "info",
                "Log Message": "master_schema.csv generated: ${biolink.schema.total_matched} matched columns (${biolink.schema.pii_columns} PII, ${biolink.schema.clinical_columns} clinical)"
              }
            }
          }
        ],
        "connections": [
          { "identifier": "c-sg-1", "source": { "id": "schema-gen-trigger",   "type": "PROCESSOR" }, "destination": { "id": "schema-gen-processor", "type": "PROCESSOR" }, "selectedRelationships": ["success"] },
          { "identifier": "c-sg-2", "source": { "id": "schema-gen-processor", "type": "PROCESSOR" }, "destination": { "id": "schema-gen-log",       "type": "PROCESSOR" }, "selectedRelationships": ["success"] },
