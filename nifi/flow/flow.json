            "identifier": "bhs-getfile",
            "name": "GetFile - BHS CSV",
            "type": "org.apache.nifi.processors.standard.GetFile",
            "position": { "x": 0, "y": 0 },
            "config": {
              "properties": {
                "Input Directory": "#{data.directory}",
                "File Filter": "BHS_Full_chunk_.*\\.csv",
