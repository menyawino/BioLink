# BioLink Backend Docker Environment Configuration
# These values are used when running in Docker Compose

# ============================================
# Server Configuration
# ============================================
PORT=3001
HOST=0.0.0.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# ============================================
# Database Configuration (Docker Services)
# ============================================
DATABASE_URL=postgresql+psycopg2://biolink:biolink_secret@postgres:5432/biolink
RAG_PG_URL=postgresql://biolink:biolink_secret@pgvector:5432/biolink_vector

# PostgreSQL
POSTGRES_USER=biolink
POSTGRES_PASSWORD=biolink_secret
POSTGRES_DB=biolink

# pgvector
PGVECTOR_USER=biolink
PGVECTOR_PASSWORD=biolink_secret
PGVECTOR_DB=biolink_vector

# ============================================
# AI/LLM Configuration (Docker Services)
# ============================================
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_ORCHESTRATOR_MODEL=llama3.2:3b
OLLAMA_DATA_MODEL=llama3.2:3b
OLLAMA_MEDICAL_MODEL=llama3.2:3b
OLLAMA_CODING_MODEL=llama3.2:3b

# Agent Configuration
SQL_AGENT_DEFAULT_LIMIT=200
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_S=0.4
LLM_RETRY_JITTER_S=0.2
ORCHESTRATOR_LLM_TIMEOUT_S=8.0
DATA_LLM_TIMEOUT_S=20.0
MEDICAL_LLM_TIMEOUT_S=20.0

# ============================================
# RAG Configuration
# ============================================
RAG_EMBEDDING_MODEL=nomic-embed-text
RAG_EMBEDDING_DIM=768
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=5

# ============================================
# Security Configuration
# ============================================
SECRET_KEY=${SECRET_KEY:-biolink-development-secret-key-change-in-production}
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10

# ============================================
# Redis Configuration (Docker Service)
# ============================================
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL=300

# ============================================
# Superset Configuration (Docker Service)
# ============================================
SUPERSET_URL=http://superset:8088
# Override with the public Superset hostname for non-local deployments.
SUPERSET_PUBLIC_URL=http://localhost:8088
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_ADMIN_EMAIL=admin@biolink.local
SUPERSET_ADMIN_FIRSTNAME=Bio
SUPERSET_ADMIN_LASTNAME=Link
SUPERSET_DATABASE_NAME=BioLink PostgreSQL
SUPERSET_LEGACY_DATABASE_NAMES=BioLink
SUPERSET_DATABASE_URI=postgresql://biolink:biolink_secret@postgres:5432/biolink
SUPERSET_DEFAULT_SCHEMA=public
SUPERSET_DEFAULT_TABLE=unified_registry
# Leave SUPERSET_EMBEDDED_ALLOWED_DOMAINS unset to reuse CORS_ALLOWED_ORIGINS.

# ============================================
# ETL Configuration
# ============================================
ETL_SERVICE_URL=https://nifi:8443/nifi-api
ETL_UPLOAD_WRITE_DIR=/shared/etl_uploads
ETL_UPLOAD_READ_DIR=/shared/etl_uploads

# ============================================
# Debezium / Kafka Configuration
# ============================================
DEBEZIUM_BOOTSTRAP=kafka:9092
DEBEZIUM_TOPIC=biolink.public.patients
CONNECT_URL=http://connect:8083

# ============================================
# Monitoring & Observability
# ============================================
ENABLE_METRICS=true
METRICS_PORT=9090
SENTRY_DSN=${SENTRY_DSN:-}

# ============================================
# Feature Flags
# ============================================
ENABLE_AUTH=false
ENABLE_RATE_LIMITING=true
ENABLE_CACHE=true
ENABLE_AUDIT_LOG=true
