# PostgreSQL (Docker internal networking)
DATABASE_URL=postgresql://biolink:biolink_secret@postgres:5432/biolink
PORT=3001
ENVIRONMENT=development
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Ollama models
MISTRAL_API_KEY=
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_ORCHESTRATOR_MODEL=qwen2.5:14b
OLLAMA_DATA_MODEL=qwen2.5:14b
OLLAMA_MEDICAL_MODEL=qwen2.5:14b
OLLAMA_CODING_MODEL=qwen2.5:14b
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_S=0.4
LLM_RETRY_JITTER_S=0.2
ORCHESTRATOR_LLM_TIMEOUT_S=120.0
DATA_LLM_TIMEOUT_S=120.0
MEDICAL_LLM_TIMEOUT_S=120.0
SQL_AGENT_DEFAULT_LIMIT=200
SECRET_KEY=change-me-in-production-use-a-long-random-string
SUPERSET_URL=http://superset:8088
SUPERSET_PUBLIC_URL=http://localhost:8088
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=CHANGE_ME_SUPerset_PASSWORD

# RAG / pgvector
RAG_PG_URL=postgresql://biolink:biolink_secret@pgvector:5432/biolink_vector
RAG_EMBEDDING_MODEL=nomic-embed-text
RAG_EMBEDDING_DIM=768
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=5

# Debezium / Kafka
DEBEZIUM_BOOTSTRAP=kafka:9092
DEBEZIUM_TOPIC=biolink.public.patients
CONNECT_URL=http://connect:8083
